@startuml cloud_bot_cloud_run
title Cloud Bot - Cloud Run Webhook Infrastructure

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

actor "Telegram user" as user
cloud "Telegram Bot API\nhttps://api.telegram.org" as telegram

package "Google Cloud project" {
  package "Cloud Run service\nAustralia Southeast 1" {
    node "Webhook container\n2 vCPU / 2 GiB / port 8080\nmin 0, max 1, concurrency 10\ntimeout 300 seconds" as cloud_run {
      component "FastAPI + Uvicorn\nPOST /webhook\nGET /health\napp.webhook:app" as webhook_app
      component "RAG pipeline\nquery, retrieve, cite" as retrieval
      component "multilingual-e5-small\nlocal CPU embeddings\n384 dimensions" as embedder
    }
  }

  cloud "Secret Manager\nTelegram, webhook, Gemini,\nQdrant and Valkey secrets" as secret_manager
  cloud "Cloud Billing budget\n0 VND/month alert\nnotifications only" as billing_budget
}

package "Managed services" {
  database "Qdrant Cloud\ncloud_bot_knowledge_e5\nHTTPS + API key" as qdrant
  database "Upstash Valkey\nrediss:// + token\nsessions and Modal quota" as valkey
}

package "LLM providers" {
  cloud "Gemini Developer API\ngemini-3.5-flash-lite\ndefault, free-tier quota applies" as gemini
  cloud "Modal private endpoint\nQwen3-4B-Instruct on L4\noptional, scale-to-zero" as modal
  cloud "Vertex AI\noptional provider, not active" as vertex
}

folder "Knowledge files\nMarkdown / TXT" as documents
component "Local ingestion CLI\nchunk + embed + upsert" as ingestion
artifact "Local .env\nGit-ignored; not uploaded" as local_env

user --> telegram : 1. Send message
telegram --> webhook_app : 2. HTTPS POST /webhook\nsecret header validated
webhook_app --> valkey : 3. Load session history
webhook_app --> retrieval : 4. Retrieve relevant context
retrieval --> embedder : 5. query: text
embedder --> qdrant : 6. Vector search (384d)
qdrant --> retrieval : 7. Matching chunks + citations
webhook_app --> gemini : 8a. Generate reply (default)
webhook_app ..> modal : 8b. Optional inference\nquota checked in Valkey
webhook_app ..> vertex : 8c. Optional if configured
gemini --> webhook_app : 9. Generated answer
modal ..> webhook_app : 9. Generated answer
webhook_app --> valkey : 10. Save history / quota
webhook_app --> telegram : 11. Send reply
telegram --> user : 12. Deliver answer

documents --> ingestion
ingestion --> embedder : passage: text
ingestion --> qdrant : Upsert vectors + metadata

secret_manager ..> cloud_run : Secret references at runtime
local_env ..> ingestion : Local credentials
billing_budget ..> cloud_run : Project-scoped spend alerts

note bottom of cloud_run
  **Cloud Run runtime:**
  - Scale to zero while idle; free allowance is quota-limited
  - Usage beyond free quotas can incur charges
  - WEBHOOK_SECRET checked with constant-time comparison
end note

note bottom of valkey
  **Session and quota state:**
  - Conversation history: 4 turns, 1-day TTL
  - Modal monthly quota: maximum 400 calls
  - TLS connection (rediss://)
end note

note bottom of billing_budget
  A zero budget sends notifications when spend is detected.
  It does not cap spend or automatically stop Cloud Run.
end note

@enduml