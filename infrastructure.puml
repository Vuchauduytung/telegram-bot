@startuml cloud_bot_infrastructure
title Cloud Bot - Deployed Infrastructure and RAG Target

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

actor "Telegram user" as user
cloud "Telegram Bot API" as telegram
cloud "Gemini Developer API\nfree tier, quota limited" as gemini_api
cloud "Vertex AI\noptional paid provider" as vertex
cloud "Modal Qwen3 4B FP16 / L4\noptional paid, scale-to-zero" as modal_paid

node "Bot host" as host {
  node "Docker Compose network" as compose {
    component "Telegram bot\npython-telegram-bot polling\napp.main" as bot
    component "multilingual-e5-small\nlocal CPU embeddings\n384 dimensions" as embedder
    database "Qdrant\ncloud_bot_knowledge\nprivate port :6333" as qdrant
    database "Valkey\nper-chat conversation history" as valkey
  }

  folder "Persistent storage" as storage {
    artifact "qdrant-data volume" as qdrant_data
    artifact "valkey-data volume" as valkey_data
  }

  artifact ".env\nBOT_TOKEN + GEMINI_API_KEY\nGit-ignored" as bot_env
}

folder "Knowledge documents\nMarkdown / TXT, read-only mount" as documents
component "Ingestion CLI\nparse, chunk, local embeddings" as ingestion
component "RAG retrieval\ntop-k + context + citations" as retrieval

user --> telegram : chat messages
bot --> telegram : HTTPS long polling
bot --> valkey : read/write history
bot --> embedder : query: prefix
embedder --> qdrant : query vector + top-k search
valkey ..> valkey_data : persists data
qdrant ..> qdrant_data : persists vectors

bot --> gemini_api : HTTPS generateContent
bot ..> vertex : optional paid generation
bot ..> modal_paid : optional paid generation

documents --> ingestion
ingestion --> embedder : passage: prefix
ingestion --> qdrant : upsert chunks + source metadata
bot --> retrieval : semantic query
retrieval --> qdrant : dense vector search
retrieval --> bot : context + citations

note bottom of retrieval
  Free profile: Markdown/TXT, local embeddings,
  Qdrant dense top-k retrieval, and source citations.
  Gemini free tier has usage quotas. Vertex/Modal are not used
  unless an explicitly paid Compose profile is selected.
end note

note right of modal_paid
  min_containers=0, max_containers=1,
  60-second idle scale-down, 8K context,
  max 256 generated tokens, 400 bot calls/month.
  App quota is not a billing hard cap.
  Cloud Functions has no GPU attachment;
  Cloud Run GPU is a separate product.
end note

@enduml