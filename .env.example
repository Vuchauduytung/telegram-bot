BOT_TOKEN=replace-with-telegram-bot-token

# Choose "gemini" or "modal".
LLM_PROVIDER=gemini
BOT_SYSTEM_PROMPT=You are a helpful assistant. Answer clearly, accurately, and in the user's language.

# Gemini through Vertex AI
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Modal OpenAI-compatible endpoint; use the URL printed by the Modal deployment.
MODAL_LLM_URL=
MODAL_LLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
VALKEY_URL=redis://localhost:6379/0
SESSION_MAX_TURNS=10
SESSION_TTL=86400

# RAG knowledge base (Markdown/TXT files under ./knowledge)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cloud_bot_knowledge
KNOWLEDGE_DIR=knowledge
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=160
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_CONTEXT_MAX_CHARS=10000