TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# Legacy alias accepted by the app:
BOT_TOKEN=

# Free-tier generation through Gemini Developer API (AI Studio).
LLM_PROVIDER=gemini-api
GEMINI_API_KEY=add-your-ai-studio-key-here
BOT_SYSTEM_PROMPT=You are a helpful assistant. Answer clearly, accurately, and in the user's language.

# Optional paid Vertex AI generation/embedding configuration.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Modal OpenAI-compatible endpoint; the Proxy Token must be ID.SECRET (wk-....ws-....).
MODAL_ENDPOINT_URL=
# Combined Modal Proxy Token: token-id.token-secret (wk-....ws-....).
MODAL_PROXY_TOKEN=
# Legacy aliases accepted by the app and Modal Compose profile.
MODAL_LLM_URL=
MODAL_LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_MAX_REQUESTS_PER_MONTH=400

LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=512
VALKEY_URL=
VALKEY_TOKEN=
SESSION_MAX_TURNS=10
SESSION_TTL=86400

# RAG & CACHE: leave URLs blank for local Compose; set URL and credentials for managed services.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=cloud_bot_knowledge
KNOWLEDGE_DIR=knowledge
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=160
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_CONTEXT_MAX_CHARS=10000

# Optional tooling/download credentials; not required for normal bot operation.
GITHUB_TOKEN=
HF_TOKEN=